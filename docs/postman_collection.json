  "item": [
    {
      "name": "1. Webhooks (POST /webhooks/kyc)",
      "item": [
        {
          "name": "POST /webhooks/kyc - 200 OK (Auto-Signed)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const secret = pm.collectionVariables.get('KYC_WEBHOOK_SECRET') || 'local-dev-kyc-secret';",
                  "const resolvedBody = pm.variables.replaceIn(pm.request.body.raw || '');",
                  "pm.request.body.raw = resolvedBody;",
                  "const cryptoLib = typeof CryptoJS !== 'undefined' ? CryptoJS : require('crypto-js');",
                  "const signature = cryptoLib.HmacSHA256(resolvedBody, secret).toString(cryptoLib.enc.Hex);",
                  "pm.variables.set('kyc_signature', signature);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.eql({ received: true });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-KYC-Signature",
                "value": "{{kyc_signature}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"evt-postman-{{$guid}}\",\n  \"investor_id\": \"inv-uuid-456\",\n  \"new_status\": \"approved\",\n  \"timestamp\": \"{{$isoTimestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/kyc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "kyc"
              ]
            },
            "description": "Dispatches a valid KYC status change webhook. Pre-request script automatically signs the body with HMAC SHA-256."
          }
        },
        {
          "name": "POST /webhooks/kyc - 200 OK (Duplicate Idempotency)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const secret = pm.collectionVariables.get('KYC_WEBHOOK_SECRET') || 'local-dev-kyc-secret';",
                  "const resolvedBody = pm.variables.replaceIn(pm.request.body.raw || '');",
                  "pm.request.body.raw = resolvedBody;",
                  "const cryptoLib = typeof CryptoJS !== 'undefined' ? CryptoJS : require('crypto-js');",
                  "const signature = cryptoLib.HmacSHA256(resolvedBody, secret).toString(cryptoLib.enc.Hex);",
                  "pm.variables.set('kyc_signature', signature);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Duplicate event returns 200 OK idempotently', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.eql({ received: true });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-KYC-Signature",
                "value": "{{kyc_signature}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"evt-fixed-duplicate-101\",\n  \"investor_id\": \"inv-uuid-456\",\n  \"new_status\": \"approved\",\n  \"timestamp\": \"2026-06-20T14:30:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/kyc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "kyc"
              ]
            },
            "description": "Sending this request tests idempotency. Duplicate events return 200 OK immediately without reprocessing."
          }
        },
        {
          "name": "POST /webhooks/kyc - 401 Unauthorized (Invalid Signature)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invalid signature returns 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().message).to.include('Invalid KYC webhook signature');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-KYC-Signature",
                "value": "deadbeef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"evt-tampered-123\",\n  \"investor_id\": \"inv-uuid-456\",\n  \"new_status\": \"approved\",\n  \"timestamp\": \"2026-06-20T14:30:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/kyc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "kyc"
              ]
            },
            "description": "Tests invalid HMAC signature rejection."
          }
        },
        {
          "name": "POST /webhooks/kyc - 400 Bad Request (Missing Fields)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const secret = pm.collectionVariables.get('KYC_WEBHOOK_SECRET') || 'local-dev-kyc-secret';",
                  "const resolvedBody = pm.variables.replaceIn(pm.request.body.raw || '');",
                  "pm.request.body.raw = resolvedBody;",
                  "const cryptoLib = typeof CryptoJS !== 'undefined' ? CryptoJS : require('crypto-js');",
                  "const signature = cryptoLib.HmacSHA256(resolvedBody, secret).toString(cryptoLib.enc.Hex);",
                  "pm.variables.set('kyc_signature', signature);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Missing fields returns 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-KYC-Signature",
                "value": "{{kyc_signature}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"evt-missing-fields\",\n  \"new_status\": \"invalid_status_enum\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/kyc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
