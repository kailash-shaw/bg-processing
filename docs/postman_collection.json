    },
    {
      "name": "2. Investor KYC Status (GET /investors/:id/kyc-status)",
      "item": [
        {
          "name": "GET /investors/:id/kyc-status - 200 OK (Matching Tenant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK with investor details', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('investor_id', 'inv-uuid-456');",
                  "    pm.expect(data).to.have.property('kyc_status');",
                  "    pm.expect(data).to.have.property('email');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_tenant_1}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/investors/inv-uuid-456/kyc-status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "investors",
                "inv-uuid-456",
                "kyc-status"
              ]
            },
            "description": "Successfully retrieves investor KYC status using a Bearer token with matching tenant_id."
          }
        },
        {
          "name": "GET /investors/:id/kyc-status - 403 Forbidden (Tenant Mismatch)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 Forbidden on tenant mismatch', function () {",
                  "    pm.response.to.have.status(403);",
                  "    pm.expect(pm.response.json().message).to.include('Investor does not belong to the authenticated tenant');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_tenant_2}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/investors/inv-uuid-456/kyc-status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "investors",
                "inv-uuid-456",
                "kyc-status"
              ]
            },
            "description": "Demonstrates tenant isolation. Token from tenant-global-2 attempting to access investor from tenant-meridian-1 returns 403 Forbidden."
          }
        },
        {
          "name": "GET /investors/:id/kyc-status - 404 Not Found (Missing Investor)",
          "event": [
            {
              "listen": "test",
